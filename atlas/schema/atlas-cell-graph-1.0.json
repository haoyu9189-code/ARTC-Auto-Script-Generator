{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-cell-graph/1.0",
  "title": "ATLAS labeled quotient graph(周期点阵单胞图表示)",
  "description": "节点为分数坐标 [0,1)^3,边带整数 shift 向量(labeled quotient graph / voltage graph)。LLM 可直接提案此格式;确定性校验器(C1-C9 硬门)在任何 FEM 之前裁决。",
  "type": "object",
  "required": ["schema", "name", "cell", "nodes", "edges",
               "default_radius_mm", "free_params", "lineage"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "atlas-cell-graph/1.0"},
    "name": {"type": "string", "minLength": 1},
    "cell": {
      "type": "object",
      "required": ["size_mm"],
      "additionalProperties": false,
      "properties": {
        "size_mm": {"type": "number", "exclusiveMinimum": 0},
        "lattice_vectors": {
          "description": "可选,非立方胞预留;省略 = 立方",
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "array", "minItems": 3, "maxItems": 3,
                    "items": {"type": "number"}}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "frac"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
          "frac": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
          },
          "aliases": {
            "description": "归并前的原始节点名(provenance)",
            "type": "array", "items": {"type": "string"}
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n1", "n2", "shift"],
        "additionalProperties": false,
        "properties": {
          "n1": {"type": "string"},
          "n2": {"type": "string"},
          "shift": {
            "description": "n2 相对 n1 的胞偏移(整数向量);跨界边非零",
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "integer", "minimum": -3, "maximum": 3}
          },
          "radius_mm": {
            "description": "省略时取 default_radius_mm",
            "type": "number", "exclusiveMinimum": 0
          }
        }
      }
    },
    "default_radius_mm": {"type": "number", "exclusiveMinimum": 0},
    "free_params": {
      "description": "命名连续自由度(Tier-1.5 插值 / CMA-ES 抛光的参数空间)",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "min", "max"],
        "additionalProperties": false,
        "properties": {
          "value": {"type": "number"},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "description": {"type": "string"}
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": ["tier", "generator", "source"],
      "additionalProperties": false,
      "properties": {
        "tier": {"enum": ["seed", "tier1.5", "tier1.75", "tier2"]},
        "generator": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "parents": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "novelty": {
      "description": "B5 填充:WL 哈希与查重结果",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wl_hash": {"type": "string"},
        "duplicate_of": {"type": ["string", "null"]}
      }
    }
  }
}
